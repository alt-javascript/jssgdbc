{
  "name": "jssgdbc",
  "version": "0.0.0",
  "description": "JavaScript Semantic Graph Database Connectivity — a uniform async API for triple stores",
  "keywords": ["triple-store", "rdf", "sparql", "graph-database", "spo", "driver", "facade"],
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test:conformance": "node scripts/run-conformance.js",
    "test:packaging": "node --test scripts/package-safeguards.test.js",
    "test": "npm run test:packaging && npm test --workspace=packages/core --workspace=packages/memory --workspace=packages/file --workspace=packages/sparql --workspace=packages/neo4j"
  },
  "author": "Craig Parravicini",
