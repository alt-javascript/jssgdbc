{
  "name": "@alt-javascript/jssgdbc-sparql",
  "version": "0.0.0",
  "description": "SPARQL endpoint driver and query/update builder for jssgdbc",
  "keywords": ["sparql", "query-builder", "rdf", "triple-store", "endpoint"],
  "private": true,
  "type": "module",
  "main": "index.js",
  "sideEffects": ["./index.js", "./SparqlDriver.js"],
  "exports": {
    ".": {
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alt-javascript/jssgdbc",
    "directory": "packages/sparql"
  },
  "homepage": "https://github.com/alt-javascript/jssgdbc/tree/main/packages/sparql#readme",
  "scripts": {
    "prepublishOnly": "node ../../scripts/prevent-publish.js",
    "test": "mocha --recursive 'test/**/*.spec.js'",
    "test:integration": "node test/run-integration.js"
  },
  "dependencies": {
    "@alt-javascript/jssgdbc-core": "0.0.0"
  },
  "devDependencies": {
    "chai": "^4.3.7",
    "mocha": "^10.2.0"
  },
  "author": "Craig Parravicini",
  "contributors": [
    "Claude (Anthropic)"
  ],
  "license": "MIT"
}
