{
  "name": "@alt-javascript/jssgdbc-file",
  "version": "0.0.0",
  "description": "File-based triple-store driver for jssgdbc — persists triples to N-Triples (.nt) files",
  "keywords": [
    "triple-store",
    "rdf",
    "n-triples",
    "file",
    "serialization",
    "parser"
  ],
  "private": true,
  "type": "module",
  "main": "index.js",
  "sideEffects": [
    "./index.js",
    "./FileDriver.js"
  ],
  "exports": {
    ".": {
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alt-javascript/jssgdbc",
    "directory": "packages/file"
  },
  "homepage": "https://github.com/alt-javascript/jssgdbc/tree/main/packages/file#readme",
  "scripts": {
    "prepublishOnly": "node ../../scripts/prevent-publish.js",
    "test": "mocha --recursive 'test/**/*.spec.js'"
  },
  "dependencies": {
    "@alt-javascript/jssgdbc-core": "0.0.0",
    "n3": "2.13.12"
  },
  "devDependencies": {
    "chai": "^4.3.7",
    "mocha": "^10.2.0"
  },
  "author": "Craig Parravicini",
  "contributors": [
    "Claude (Anthropic)"
  ],
  "license": "MIT"
}
