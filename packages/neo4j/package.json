{
  "name": "@alt-javascript/jssgdbc-neo4j",
  "version": "0.0.0",
  "description": "Neo4j graph driver and parameterized SPO-to-Cypher builder for jssgdbc",
  "keywords": ["neo4j", "cypher", "query-builder", "rdf", "triple-store"],
  "private": true,
  "type": "module",
  "main": "index.js",
  "sideEffects": ["./index.js"],
  "exports": {
    ".": {
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alt-javascript/jssgdbc",
    "directory": "packages/neo4j"
  },
  "homepage": "https://github.com/alt-javascript/jssgdbc/tree/main/packages/neo4j",
  "scripts": {
    "prepublishOnly": "node ../../scripts/prevent-publish.js",
    "test": "node --test test/cypher-builder.test.js test/neo4j-client.test.js test/neo4j-graph.test.js test/integration-runner.test.js test/lifecycle.test.js",
    "test:integration": "node test/run-integration.js"
  },
  "dependencies": {
    "@alt-javascript/jssgdbc-core": "0.0.0",
    "neo4j-driver": "^5.28.0"
  },
  "devDependencies": {
    "chai": "^4.3.7",
    "mocha": "^10.2.0"
  },
  "author": "Craig Parravicini",
  "contributors": ["Claude (Anthropic)"],
  "license": "MIT"
}
